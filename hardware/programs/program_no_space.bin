# =======================
# Preparing data
# =======================
# 00101 = LCD Controller address
# 00110 = Button Controller address
# 00111 = LCD Base symbol (0)
# 11100 = LCD Base symbol (A)
# 11101 = Constant value for comparing (10)
# 11110 = Data from Button Controller
# 11111 = Data for transfering from Button -> Data Memory -> some op -> LCD

00000000000010000000001010110111
10000000000000000000001100110111
00000011000000111000001110010011
00000100000111100000111000010011
00000000101011101000111010010011

